<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      MANAGE_EXTERNAL_STORAGE, and not the media permissions.

      CrossPoint is a FILE-based reader: it browses folders, keeps a per-book
      cache, and writes progress and bookmarks next to the EPUB. Modern
      Android's granular permissions (READ_MEDIA_*) cover images, audio and
      video, and an .epub is none of the three. The Storage Access Framework
      would cover it, but it hands back URIs rather than paths, and the whole
      CrossPoint tree speaks POSIX through the shim: adopting it means
      rewriting the file browser, the cache and the progress store against a
      model the reader does not have.

      This is the same choice serious Android EPUB readers make, for the same
      reason. The user grants it in Settings > Special app access, through the
      system's own dialog, and can revoke it whenever.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
      INTERNET: OPDS, KOReader sync and font downloads. Without it every
      connection fails with SecurityException and the error surfaces as "the
      server did not respond", which sends you looking in the wrong place.

      ACCESS_NETWORK_STATE: knowing whether there is a network before trying,
      so the message is "no connection" and not a fifteen-second timeout.

      Deliberately ABSENT: ACCESS_FINE_LOCATION. Reading the connected
      network's name needs location permission on Android 10+, because the SSID
      identifies where you are. CrossPoint shows the network name in the status
      bar; here it shows the IP and the connected state instead. Asking for
      location over a label would be the first time in this port a broad
      permission is requested for something cosmetic.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!--
          screenOrientation=portrait: the panel is 824x1648 and the reader has
          its own notion of orientation, which it applies in the framebuffer.
          Letting Android rotate as well would stack two rotations.

          configChanges: without this, any configuration change destroys and
          recreates the Activity. The reader thread survives that (nativeStart
          is idempotent), but the surface goes away and comes back each time,
          and an e-ink screen flashing because the keyboard changed is ugly for
          no reason.
        -->
        <activity
            android:name=".ReaderActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
